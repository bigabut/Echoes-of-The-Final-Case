  m_Script: {fileID: 11500000, guid: 005cecb7c2f03494c893a83f0bd5bc33, type: 3}
  m_Name: Case2-Informan
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSystem
  lines:
  - text: 'Permisi, kamu melihat Reza Ellis hari ini? '
    speakerIndex: 0
    autoProgress: 0
  - text: Baju agak santai, pakai hoodie, anggota klub Investigasi.
    speakerIndex: 0
    autoProgress: 0
  - text: "Reza? \u2026 Oh dia yang sering ke kantin sebelum kelas pagi ya."
    speakerIndex: 1
    autoProgress: 0
  - text: Aku melihatnya tadi. Dia kelihatan buru-buru. Bahkan minumannya ditinggal
      begitu saja.
    speakerIndex: 1
    autoProgress: 0
  - text: Dia pergi ke mana?
    speakerIndex: 0
    autoProgress: 0
  - text: ' Ke arah ruang kelas.'
    speakerIndex: 1
    autoProgress: 0
  - text: ' Tapi sebelum pergi, dia sempat melihat ke belakang beberapa kali, seperti
      takut ada yang mengikutinya.'
    speakerIndex: 1
    autoProgress: 0
  - text: Ada orang lain bersamanya?
    speakerIndex: 0
    autoProgress: 0
  - text: Nggak ada. Dia sendirian.
    speakerIndex: 1
    autoProgress: 0
  - text: Reza tidak biasanya bertingkah seperti ini.
    speakerIndex: 0
    autoProgress: 0
  - text: ' Apa yang sebenarnya dia temukan sampai harus terburu-buru pergi?

'
    speakerIndex: 0
    autoProgress: 0
  autoProgressDelay: 1.5
  typingSpeed: 0.05
  voiceSound: {fileID: 0}
  voicePitch: 1
