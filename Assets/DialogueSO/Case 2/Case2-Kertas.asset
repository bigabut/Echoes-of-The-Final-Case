  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 005cecb7c2f03494c893a83f0bd5bc33, type: 3}
  m_Name: Case2-Kertas
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSystem
  lines:
  - text: Ada catatan jatuh dari kliping berita.
    speakerIndex: 0
    autoProgress: 0
  - text: '"Kalau aku belum kembali, coba cari tahu apa yang sebenarnya terjadi pada
      ujian itu." '
    speakerIndex: 0
    autoProgress: 0
  - text: '"Jangan percaya begitu saja pada apa yang terlihat." '
    speakerIndex: 0
    autoProgress: 0
  - text: 'Belum kembali? Maksudnya apa? '
    speakerIndex: 0
    autoProgress: 0
  - text: ' Itu tulisan Reza? '
    speakerIndex: 1
    autoProgress: 0
  - text: 'Iya. Sepertinya dia sengaja meninggalkannya.  '
    speakerIndex: 0
    autoProgress: 0
  - text: 'Biasanya di kemana kalau bukan kelas atau ruang UKM? '
    speakerIndex: 0
    autoProgress: 0
  - text: Mungkin ke Kantin? Biasanya dia selalu ke sana sebelum kelas dimulai.
    speakerIndex: 1
    autoProgress: 0
  - text: ' Oke, aku bakal pergi ke kantin. '
    speakerIndex: 0
    autoProgress: 0
  - text: 'Tunggu bentar Arwan. Bukannya Tama nyuruh kamu ke sekre UKM? '
    speakerIndex: 1
    autoProgress: 0
  - text: Oh iya, katanya ada pengumuman ya. Makasih ya, kamu ikut?
    speakerIndex: 0
    autoProgress: 0
  - text: Mungkin kali ini kamu harus belajar buat nggak bareng aku.
    speakerIndex: 1
    autoProgress: 0
  - text: Ngomong apa sih kamu? Eh tau ya, kamu tuh sengangenin itu loh.
    speakerIndex: 0
    autoProgress: 0
  autoProgressDelay: 1.5
  typingSpeed: 0.05
  voiceSound: {fileID: 0}
  voicePitch: 1
