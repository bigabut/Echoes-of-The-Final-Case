  lines:
  - text: 'Keterangan: Pembayaran dokumen ujian.'
    speakerIndex: 0
    autoProgress: 0
  - text: 'Nominal: Rp2.500.000.'
    speakerIndex: 0
    autoProgress: 0
  - text: 'Catatan: Pembayaran lanjutan setelah pengumuman nilai.'
    speakerIndex: 0
    autoProgress: 0
  - text: Dua setengah juta cuma buat dokumen ujian?
    speakerIndex: 0
    autoProgress: 0
  - text: Ini... kunci jawaban?
    speakerIndex: 0
    autoProgress: 0
  - text: ': Soal yang sama, pembayaran, dan rekaman penyerahan amplop. Ini bukan
      lagi dugaan biasa.'
    speakerIndex: 0
    autoProgress: 0
