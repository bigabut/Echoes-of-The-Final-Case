  m_Script: {fileID: 11500000, guid: 005cecb7c2f03494c893a83f0bd5bc33, type: 3}
  m_Name: Case3-Monitor CCTV
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSystem
  lines:
  - text: Semoga rekamannya masih tersimpan.
    speakerIndex: 0
    autoProgress: 0
  - text: ........
    speakerIndex: 0
    autoProgress: 0
  - text: Nah dapat file rekamannya, coba kita periksa
    speakerIndex: 0
    autoProgress: 0
  - text: Rekaman pukul 16.42. Ada seorang mahasiswa memasuki ruang kelas membawa
      map berwarna hitam.
    speakerIndex: 0
    autoProgress: 0
  - text: Rekaman pukul 17.10. Mahasiswa itu meninggalkan ruangan dan menuju kantin.
    speakerIndex: 0
    autoProgress: 0
  - text: Rekaman pukul 17.18. Terlihat penyerahan sebuah amplop kecil di salah satu
      meja kantin.
    speakerIndex: 0
    autoProgress: 0
  - text: Amplop? Apakah itu pembayaran untuk kunci jawaban?
    speakerIndex: 0
    autoProgress: 0
  - text: Wajahnya tidak terlihat jelas. Tapi arah perginya sesuai dengan catatan
      yang kutemukan.
    speakerIndex: 0
    autoProgress: 0
  autoProgressDelay: 1.5
  typingSpeed: 0.05
  voiceSound: {fileID: 0}
  voicePitch: 1
