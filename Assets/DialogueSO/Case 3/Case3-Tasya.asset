  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 005cecb7c2f03494c893a83f0bd5bc33, type: 3}
  m_Name: Case3-Tasya
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSystem
  lines:
  - text: ' Arwan! Kamu menemukan sesuatu?'
    speakerIndex: 1
    autoProgress: 0
  - text: Lihat ini.
    speakerIndex: 0
    autoProgress: 0
  - text: ' Bau banget! Kamu ambil ini dari mana sih?'
    speakerIndex: 1
    autoProgress: 0
  - text: Tempat sampah.
    speakerIndex: 0
    autoProgress: 0
  - text: Hah?
    speakerIndex: 1
    autoProgress: 0
  - text: 'Iya, kayaknya pelaku asal membuangnya ke tempat sampah habis dipakai.

'
    speakerIndex: 0
    autoProgress: 0
  - text: ' Jadi, benar... Ada transaksi uang untuk mendapatkan kunci jawaban.

'
    speakerIndex: 1
    autoProgress: 0
  - text: Dan sepertinya ada lebih banyak orang yang terlibat daripada yang kita
      duga.
    speakerIndex: 0
    autoProgress: 0
  - text: 'Aku akan mencoba mencocokkan nama-nama dalam dokumen dengan catatan Reza.

'
    speakerIndex: 1
    autoProgress: 0
  - text: Kamu udah bahas masalah ini sama Reza?
    speakerIndex: 0
    autoProgress: 0
  - text: Iya, tadi aku nanya ke Reza di ruang UKM.
    speakerIndex: 1
    autoProgress: 0
  - text: Kita harus memberi tahu Reza dan Tama.
    speakerIndex: 0
    autoProgress: 0
  - text: Setuju. Tapi menurutku jangan sebarkan bukti ini dulu.
    speakerIndex: 1
    autoProgress: 0
  - text: Kita belum tahu siapa yang berada di balik transaksi tersebut.
    speakerIndex: 1
    autoProgress: 0
  - text: ......
    speakerIndex: 1
    autoProgress: 0
  - text: Kalau ini benar-benar sindikat...
    speakerIndex: 1
    autoProgress: 0
  - text: orang yang membayar mungkin bukan orang yang mengatur semuanya.
    speakerIndex: 1
    autoProgress: 0
  - text: Maksudmu ada pihak yang lebih besar?
    speakerIndex: 0
    autoProgress: 0
  - text: Bisa jadi. Seseorang yang punya akses ke berkas ujian, data mahasiswa,
      dan sistem kampus.
    speakerIndex: 1
    autoProgress: 0
  - text: 
    speakerIndex: 0
    autoProgress: 0
  autoProgressDelay: 1.5
  typingSpeed: 0.05
  voiceSound: {fileID: 0}
  voicePitch: 1
