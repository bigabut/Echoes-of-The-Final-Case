  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 005cecb7c2f03494c893a83f0bd5bc33, type: 3}
  m_Name: Case1-ElenaAwal
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSystem
  lines:
  - text: El, serius ini kasus kita?
    speakerIndex: 0
    autoProgress: 0
  - text: Tentu saja! Dia kan maskot utama UKM kan? Bukan, malah maskot kampus ini
      malah kalau nanya orang-orang.
    speakerIndex: 1
    autoProgress: 0
  - text: Kasihan kan kalau kelaparan atau malah kejebak di gudang. Kita harus nyari
      dia sebelum keburu malem!
    speakerIndex: 1
    autoProgress: 0
  - text: Okee deh. Biasanya pagi-pagi begini dia ada di mana?
    speakerIndex: 0
    autoProgress: 0
  - text: 'Coba kamu cek ke Kantin, biasanya dia nongkrong di sana nunggu jatah sarapan. '
    speakerIndex: 1
    autoProgress: 0
  - text: ' Aku yang periksa tempat tidurnya di Koridor Gedung UKM.'
    speakerIndex: 1
    autoProgress: 0
  - text: Oke. Kalau ketemu atau ada petunjuk, kita kumpul lagi di koridor.
    speakerIndex: 0
    autoProgress: 0
  - text: Okee
    speakerIndex: 1
    autoProgress: 0
  autoProgressDelay: 1.5
  typingSpeed: 0.05
  voiceSound: {fileID: 0}
  voicePitch: 1
