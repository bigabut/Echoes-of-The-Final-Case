  m_EditorClassIdentifier: Assembly-CSharp::DialogueSystem
  lines:
  - text: Apaan sih kamu?
    speakerIndex: 1
    autoProgress: 0
  - text: Udah dibilangin mau aku elus. Suruh siapa imut banget.
    speakerIndex: 0
    autoProgress: 0
  - text: Iya-iya. Bisa aja terus tuh gombalnya.
    speakerIndex: 1
    autoProgress: 0
  - text: "Meong\u2026"
    speakerIndex: 2
    autoProgress: 0
  - text: ' Bangun juga kamu. Arwan foto bareng kucing yuk. Buat kenang-kenangan
      di sini.

'
    speakerIndex: 1
    autoProgress: 0
  - text: Boleh. Sebentar, biar aku yang pegang kameranya.
    speakerIndex: 0
    autoProgress: 0
  - text: 'Yey! Geser sini sedikit... Oke, siap ya! Satu... dua... tiga!

'
    speakerIndex: 1
    autoProgress: 0
  autoProgressDelay: 1.5
  typingSpeed: 0.05
  voiceSound: {fileID: 0}
  voicePitch: 1
